{
  "name": "@workfonic/mockclock",
  "version": "0.1.0",
  "description": "Control time. Test anything. Isolated, deterministic clocks with calendar-correct arithmetic, IANA time zones, DST handling and ready-made scenarios.",
  "keywords": ["clock", "time", "date", "testing", "mock", "fake-timers", "timezone", "dst", "time-travel", "scenarios"],
  "license": "MIT",
  "author": "Workfonic Labs",
  "homepage": "https://github.com/abhisarena-sketch/mockclock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisarena-sketch/mockclock.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/abhisarena-sketch/mockclock/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/copy-package-docs.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
