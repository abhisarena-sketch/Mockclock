{
  "name": "@workfonic/mockclock-cli",
  "version": "0.1.0",
  "description": "mockclock command-line tool: inspect and simulate time, time zones, DST transitions and scenarios, with JSON output and explicit session files.",
  "keywords": ["clock", "time", "cli", "timezone", "dst", "testing", "qa", "scenarios"],
  "license": "MIT",
  "author": "Workfonic Labs",
  "homepage": "https://github.com/abhisarena-sketch/mockclock/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhisarena-sketch/mockclock.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/abhisarena-sketch/mockclock/issues",
  "type": "module",
  "bin": {
    "mockclock": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/copy-package-docs.mjs"
  },
  "dependencies": {
    "@workfonic/mockclock": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
